{
  "name": "cityone",
  "version": "0.1.0",
  "private": true,
  "description": "CityOne — Mumbai multimodal journey planner with ONDC Metro ticketing",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && npm install --workspace backend && npm install --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "test:google": "node test_ganduwali.js",
    "test:railradar": "node test_railradar.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "npm-run-all": "^4.1.5"
  }
}
